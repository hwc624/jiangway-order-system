{
  "rules": {
    ".read": false,
    ".write": false,

    "staff": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "orders": {
      ".read": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      ".write": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      ".indexOn": ["dateKey"],
      "$orderId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['no', 'dateKey', 'name', 'pickup', 'items', 'total', 'pay', 'ts'])",

        "no":             { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,6}$/)" },
        "dateKey":        { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "name":           { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
        "phone":          { ".validate": "newData.isString() && newData.val().length <= 40" },
        "pickup":         { ".validate": "newData.isString() && (newData.val() === '外帶' || newData.val() === '外送' || newData.val() === '內用')" },
        "addr":           { ".validate": "newData.isString() && newData.val().length <= 300" },
        "distance":       { ".validate": "(newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000) || (newData.isString() && newData.val().length <= 10 && newData.val().matches(/^([0-9]+([.][0-9]+)?)?$/))" },
        "selDate":        { ".validate": "newData.isString() && newData.val().length <= 40" },
        "time":           { ".validate": "newData.isString() && newData.val().length <= 20" },
        "items": {
          ".validate": "newData.hasChildren()",
          "$i": {
            ".validate": "newData.hasChildren(['name', 'qty', 'price'])",
            "id":     { ".validate": "newData.isString() && newData.val().length <= 64" },
            "name":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "nameEn": { ".validate": "newData.isString() && newData.val().length <= 150" },
            "qty":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999 && newData.val() % 1 === 0" },
            "price":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "$other": { ".validate": false }
          }
        },
        "addons": {
          "$i": {
            ".validate": "newData.hasChildren(['addonName', 'qty', 'addonPrice'])",
            "addonName":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "qty":        { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999 && newData.val() % 1 === 0" },
            "addonPrice": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "$other":     { ".validate": false }
          }
        },
        "disc":           { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "fee":            { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "isFreeDelivery": { ".validate": "newData.isBoolean()" },
        "total":          { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "note":           { ".validate": "newData.isString() && newData.val().length <= 500" },
        "pay":            { ".validate": "newData.isString() && (newData.val() === '現金' || newData.val() === 'EFT' || newData.val() === '餐券')" },
        "eftProof":       { ".validate": "newData.isString() && newData.val().length <= 500" },
        "ts":             { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "$other":         { ".validate": false }
      }
    },

    "order_counters": {
      ".read": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      ".write": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      "$dateKey": {
        ".read": "$dateKey.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        ".write": "$dateKey.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
      }
    },

    "soldOut": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      "$itemId": { ".validate": "newData.isBoolean()" }
    },

    "promos": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      "$promoId": {
        "active":     { ".validate": "newData.isBoolean()" },
        "pct":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "addonPrice": { ".validate": "newData.isNumber() && newData.val() >= 0" }
      }
    },

    "menu_overrides": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      "$itemId": {
        "price": { ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    },

    "custom_items": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      "$itemId": {
        "price": { ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.token.admin === true || root.child('staff').child(auth.uid).val() === true)",
      "minOrder": { ".validate": "newData.isNumber() && newData.val() >= 0" },
      "delivFee": { ".validate": "newData.isNumber() && newData.val() >= 0" },
      "$other":   { ".validate": false }
    }
  }
}
